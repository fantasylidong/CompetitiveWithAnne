  "cards": [
    {
      "dot": "cyan",
      "title": "模式加载链",
      "items": [
        "server.cfg 把 confogl_match_execcfg_plugins 设为 generalfixes → confogl_plugins → sharedplugins",
        "ReqMatch 先 sm plugins unload_all，再按 ①②③ 顺序 exec",
        "annehappy 模式把 stripper_cfg_path 指向 cfg/stripper/zonemod_anne"
      ]
    },
    {
      "dot": "emerald",
      "title": "Anne 刷特核心",
      "items": [
        "infected_control 2026-08：kill phase → 16s 基础倒计时 → Anti-Bait hold",
        "anne_spawn_accel 不可用时回退到 .kv 旧版 buckets",
        "infected_control26-07 为回滚版，经 cfg/vote/Anne/Anne26-07.cfg 切换"
      ]
    },
    {
      "dot": "violet",
      "title": "数据库",
      "items": [
        "anne_db 按物理库共享连接，插件拿到 CloneHandle 副本",
        "未加载 anne_db 时，AnneDB_*Compat 回退到原生连接",
        "nomysql 包移除直连数据库插件，rpg 换成无数据库构建"
      ]
    },
    {
      "dot": "amber",
      "title": "发布与更新",
      "items": [
        "push 后打包完整包与 nomysql 包；release.yml 用 SM 1.12 重编",
        "join_autoupdate=1 拉公开清单，=2 拉含数据库插件的私有清单"
      ]
    }
  ]
