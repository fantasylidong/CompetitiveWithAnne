+void ActionPropagation::PruneEmptyListeners()
+{
+	for (auto action = m_actionsListeners.begin(); action != m_actionsListeners.end();)
+	{
+		auto& methods = action->second;
+		for (auto method = methods.begin(); method != methods.end();)
+		{
+			if (method->second.empty())
+				method = methods.erase(method);
+			else
+				method++;
+		}
+
+		if (methods.empty())
+			action = m_actionsListeners.erase(action);
+		else
+			action++;
+	}
+}
